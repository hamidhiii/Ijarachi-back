# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=rentoo
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# OTP
OTP_EXPIRY_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60

# Mobile app deep-link scheme (rentoo://...)
APP_DEEPLINK_SCHEME=rentoo

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Eskiz.uz SMS
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_SENDER_ID=4546
SMS_REQUEST_TIMEOUT_SECONDS=10

# Telegram OTP-бот (временная замена SMS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET=
OTP_SMS_FALLBACK_ENABLED=False

# Media (local for MVP)
MEDIA_URL=/media/
MEDIA_ROOT=media/
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=ru-central1

# Payme
PAYME_MERCHANT_ID=your-merchant-id
PAYME_SECRET_KEY=your-secret-key

# Click
CLICK_SERVICE_ID=your-service-id
CLICK_MERCHANT_ID=your-merchant-id
CLICK_SECRET_KEY=your-secret-key

# Commission rate (percent)
PLATFORM_COMMISSION_PERCENT=10

# Собственный KYC (паспорт/ID-карта + сверка лица)
KYC_FIRST_DEAL_COST=8000
KYC_FACE_MATCH_DISTANCE=0.5
KYC_LIVENESS_EAR_DELTA=0.05
KYC_LIVENESS_MOVEMENT_RATIO=0.08

