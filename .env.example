# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=rentoo
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Eskiz.uz SMS
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password

# Media (local for MVP)
MEDIA_URL=/media/
MEDIA_ROOT=media/
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=ru-central1

# Payme
PAYME_MERCHANT_ID=your-merchant-id
PAYME_SECRET_KEY=your-secret-key

# Click
CLICK_SERVICE_ID=your-service-id
CLICK_MERCHANT_ID=your-merchant-id
CLICK_SECRET_KEY=your-secret-key

# Commission rate (percent)
PLATFORM_COMMISSION_PERCENT=10

# MyID OAuth
MYID_CLIENT_ID=your-myid-client-id
MYID_CLIENT_SECRET=your-myid-client-secret
MYID_REDIRECT_URI=http://localhost:8000/api/v1/myid/callback/
MYID_AUTHORIZE_URL=https://myid.uz/oauth/authorize
MYID_TOKEN_URL=https://myid.uz/oauth/token
MYID_USERINFO_URL=https://myid.uz/api/userinfo
MYID_FIRST_DEAL_COST=8000

# Push notifications
FCM_SERVER_KEY=your-fcm-server-key
