# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# Used by Django App
DB_NAME=synth_share
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db  # Use 'localhost' for local development without Docker, 'db' for Docker Compose.
DB_PORT=5432

# Used by Docker to initialize Postgres container
POSTGRES_DB=synth_share
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://redis:6379/0  # Use redis://localhost:6379/0 for local without Docker

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Eskiz.uz SMS
ESKIZ_EMAIL=your@email.com
ESKIZ_PASSWORD=your-eskiz-password

# Media (local for MVP)
MEDIA_URL=/media/
MEDIA_ROOT=media/

# Payme
PAYME_MERCHANT_ID=your-merchant-id
PAYME_SECRET_KEY=your-secret-key

# Click
CLICK_SERVICE_ID=your-service-id
CLICK_MERCHANT_ID=your-merchant-id
CLICK_SECRET_KEY=your-secret-key

# Commission rate (percent)
PLATFORM_COMMISSION_PERCENT=10
